# คัดลอกเป็น .env แล้วใส่ค่าของคุณ
# ค่าคอนฟิกทั่วไปอยู่ที่ backend/app/defaults.py และ backend/app/audio_constants.py

# ---------- ความลับ ----------
API_KEY=
HF_TOKEN=
TYPHOON_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
GOOGLE_CLIENT_ID=
# เครื่องเทศแฮชการรับแพ็กทดลอง (HMAC ไม่เก็บอีเมลหรือ Google sub ดิบหลังปิดบัญชี)
# ตั้งครั้งเดียวเป็นค่าสุ่มยาว อย่าเปลี่ยนหลังมีผู้ใช้ ไม่งั้นแฮชเก่าจะไม่ตรง
TRIAL_CLAIM_PEPPER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SMTP_PASSWORD=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# เข้ารหัสเลขผู้เสียภาษีและเลขบัญชีนักพากย์ อย่าใส่ค่าจริงในไฟล์นี้
# วิธีสร้างคีย์และเก็บใน Kubernetes อยู่ที่ docs/pii-encryption.md
# เครื่องพัฒนาเท่านั้น (ห้ามตั้งบนคลัสเตอร์): PII_ENC_DEV_EPHEMERAL=1
PII_ENC_KEYS=
PII_ENC_ACTIVE_VERSION=
PII_HMAC_KEY=

# ---------- โดเมน / บัญชี ----------
WEB_URL=
CORS_ORIGINS=*
ADMIN_EMAILS=
AUTH_ENABLED=1
BILLING_ENABLED=1
# Swagger / ReDoc / OpenAPI (/docs /redoc /openapi.json) ปิดเป็นค่าเริ่มต้น
# เปิดเฉพาะตอนพัฒนา — ห้ามเปิดบน production
# API_DOCS_ENABLED=1
PAYMENT_PROVIDER=
PAYEE_NAME=
PAYEE_BANK=
PAYEE_ACCOUNT=
PDPA_CONTROLLER_NAME=
PDPA_CONTROLLER_CONTACT=

# อีเมลแจ้งเตือน (ว่าง SMTP_HOST / MAIL_FROM = ไม่ส่ง)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=

# ---------- ฐานข้อมูล ----------
# files = JSON ในเครื่อง | postgres = Postgres บน VPS/Docker
DB_BACKEND=postgres
DATABASE_URL=

# ---------- Cloudflare R2 ----------
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_ENDPOINT=   # ว่าง = https://{account_id}.r2.cloudflarestorage.com
# R2_PURGE_LOCAL=0

# ---------- เครื่องนี้ ----------
DATA_DIR=data
DEVICE=cuda
LOW_VRAM=0
MOCK_PIPELINE=0
# local = GPU เครื่องนี้ | modal = Modal L4
WORKER=modal
# GTX 16xx ต้องเปิด
F5_FP32=0
# F5_CACHE_DIR=
# FONTS_DIR=
# BACKUP_DIR=

# Docker / tunnel (ถ้าใช้)
# TORCH_CACHE_HOST=
# HF_CACHE_HOST=
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
