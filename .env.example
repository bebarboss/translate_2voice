# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของคุณ
# (เขียนคอมเมนต์ไว้บรรทัดของตัวเองเสมอ อย่าเขียนต่อท้ายค่า)

# ---------- ระบบ ----------
DATA_DIR=data
# ตั้งไว้ถ้าจะเปิดให้คนนอกใช้ แล้วส่งมาใน header X-API-Key
API_KEY=
MAX_UPLOAD_MB=500
DEVICE=cuda
# 1 = การ์ดจอเล็ก (ต่ำกว่า ~8 GB) ปล่อยโมเดลทิ้งหลังใช้แต่ละขั้น
LOW_VRAM=0
# 1 = ทดสอบ API โดยไม่โหลดโมเดล
MOCK_PIPELINE=0
# โหมดทดสอบ: หน่วงเวลาแต่ละขั้นกี่วินาที (ให้เห็นความคืบหน้า)
MOCK_DELAY=0.6
# โดเมนที่เรียก API จากเบราว์เซอร์ได้ (หน้าเว็บ Next.js เรียกผ่าน proxy ไม่ต้องตั้ง)
CORS_ORIGINS=*
# รับลิงก์คลิป: ความยาวสูงสุด (นาที)
MAX_URL_MINUTES=60

# ---------- คีย์ที่ต้องมี (ฟรีทั้งคู่) ----------
# https://huggingface.co/settings/tokens และกดยอมรับเงื่อนไขโมเดล pyannote
HF_TOKEN=
# https://playground.opentyphoon.ai > API Keys
TYPHOON_API_KEY=

# ---------- โมเดล ----------
DEMUCS_MODEL=htdemucs
# community-1 นับจำนวนคนแม่นกว่า 3.1 (ถ้าโหลดไม่ได้ระบบจะใช้ 3.1 แทน)
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
# 1 = คลิปภาษาอังกฤษแปลด้วย Typhoon Translate บนเครื่อง
TRANSLATE_EN_LOCAL=0
F5_MODEL=v2
# ที่เก็บโมเดลพากย์ไทย (ว่าง = แคช Hugging Face ปกติ)
F5_CACHE_DIR=
# พากย์อังกฤษ (F5-TTS รุ่นหลัก)
F5_EN_MODEL=F5TTS_v1_Base
EN_WORDS_PER_SEC=2.6
# ซับไตเติล: โฟลเดอร์ฟอนต์เพิ่มเติมนอกจากฟอนต์ที่ติดตั้งในเครื่อง (ว่างได้)
FONTS_DIR=

# ---------- ปรับแต่งเสียง ----------
# มากขึ้น = เสียงดีขึ้นแต่ช้าลง
F5_STEPS=32
F5_CFG=2.0
F5_SPEED=1.0
# 1 = คำนวณแบบ float32 (ต้องเปิดกับการ์ด GTX 16xx ไม่งั้นได้เสียงเงียบ)
F5_FP32=0
REF_MIN_SEC=2
REF_MAX_SEC=10
# เสียงตัวอย่างที่มีเพลงปนหนัก (คะแนนต่ำกว่านี้) จะใช้ท่อนที่สะอาดกว่าแทน 0 = ปิด
REF_MIN_QUALITY=2.3
# ปรับระดับเสียงและการขึ้นลงของเสียงพากย์ให้ตามต้นฉบับ (ทดลอง: เสียงคุณภาพลดลง)
PROSODY_MATCH=0
PROSODY_MAX_SHIFT=4
PROSODY_MAX_RANGE=1.6
THAI_CHARS_PER_SEC=11
# เร่งเสียงพากย์ได้สูงสุดกี่เท่าให้พอดีฉาก
MAX_SPEEDUP=1.35
# ยืดเสียงพากย์ให้เต็มฉากได้ช้าสุดกี่เท่า (โมเดลปรับจังหวะพูดเอง)
MAX_SLOWDOWN=1.2
# เว้นจังหวะหยุดกลางประโยคตามต้นฉบับ (0 = พูดรวดเดียว)
PAUSE_MATCH=1
MIN_PAUSE_SEC=0.3
# เสียงร้อง กรี๊ด อุทานจากต้นฉบับในช่วงที่ไม่มีบท (0 = ตัดทิ้ง, 1 = ดังเท่าเดิม)
NONSPEECH_GAIN=1.0
# กันเสียงพากย์ผิดคน (เด็กได้เสียงผู้ใหญ่ ผู้หญิงได้เสียงผู้ชาย): ยืมเสียงตัวอย่างเฉพาะท่อนที่ลายเสียงและระดับเสียงเข้ากัน
VOICE_MATCH=1
VOICE_MIN_SIM=0.2
VOICE_MAX_PITCH_DIFF=6
# แยกผู้พูดที่ถูกรวมกัน (เช่นเด็กกับผู้ใหญ่) เมื่อเสียงสองกลุ่มห่างกันเกินกี่เซมิโทน (มีผลกับงานใหม่)
VOICE_SPLIT_PITCH=7
# ไม่ได้ระบุจำนวนคน: ตรวจผลแยกผู้พูดด้วยลายเสียง (0 = ปิด)
# แยกกลุ่มที่ลายเสียงในกลุ่มเข้ากันต่ำกว่า DIAR_SPLIT_COHERENCE และรวมสองกลุ่มที่คล้ายกันเกิน DIAR_MERGE_SIM
DIAR_REFINE=1
DIAR_SPLIT_COHERENCE=0.55
DIAR_MERGE_SIM=0.65
# เสียงพากย์หลุดจากเสียงตัวอย่างเกินกี่เซมิโทนให้พากย์ใหม่ และลองได้กี่รอบ
VOICE_DRIFT=4
VOICE_RETRIES=1
# อารมณ์ตามต้นฉบับ: เลือกเสียงตัวอย่างที่ตื่นเต้นพอ ๆ กับฉาก และให้ฉากตื่นเต้นพูดเร็วขึ้นได้ ฉากเนิบพูดช้าลงได้
EMOTION_MATCH=1
# น้ำหนักอารมณ์ตอนเลือกเสียงตัวอย่าง (ยิ่งสูงยิ่งเน้นอารมณ์มากกว่าความสะอาด)
REF_EMOTION_WEIGHT=0.5
# ความดังตามนักแสดง (ตะโกนดัง กระซิบเบา) ปรับขึ้นได้สูงสุด/ลงได้สูงสุดกี่ dB
LOUDNESS_MATCH=1
LOUDNESS_MAX_BOOST=6
LOUDNESS_MAX_CUT=10
# เสียงก้องของห้องให้เสียงพากย์ (0 = แห้ง, 0.2 = ห้องทั่วไป) และเวลาที่เสียงก้องจางหาย (วินาที)
ROOM_REVERB=0.2
ROOM_RT60=0.4
# ตัดประโยคที่ยาวกว่านี้ (วินาที) ให้แต่ละประโยคใช้เสียงตัวเองเป็นตัวอย่าง
MAX_LINE_SEC=8
VOICE_GAIN=1.0
BGM_GAIN=1.0

# ---------- Docker + Tunnel (docker compose up -d --build) ----------
# ค่าเริ่มต้นใช้ Cloudflare quick tunnel (ฟรี ไม่ต้องตั้งค่า) ลิงก์ดูได้จาก docker compose logs tunnel
# ผ่าน Cloudflare อัปโหลดได้ครั้งละไม่เกิน 100 MB ให้ตั้ง MAX_UPLOAD_MB=95
# ค่า NGROK_* ใช้เฉพาะตอนรัน docker compose --profile ngrok up -d ngrok
# โมเดล Hugging Face / F5 เก็บใน volume hf-cache, f5-cache ของ Docker (โหลดเองครั้งแรก) ตั้งแค่แคช torch ได้
TORCH_CACHE_HOST=C:/Users/<you>/.cache/torch
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# โดเมนคงที่ฟรีของบัญชี ngrok (https://dashboard.ngrok.com/domains) เช่น xxx.ngrok-free.app ตั้งเป็น BACKEND_URL บน Vercel
NGROK_DOMAIN=
