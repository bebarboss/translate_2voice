# Non-secret settings for the pakdee namespace.
# Edit domains here. API_DOMAIN and WEB_DOMAIN are also copied onto the Ingress
# by Kustomize. KITE_HOST is not injected into the app; deploy/k8s/scripts/install-kite.sh
# reads it. Do not put passwords or API keys in this file.

# ---------- Public hostnames (production) ----------
API_DOMAIN=pakdee-api.cobie.online
WEB_DOMAIN=pakdee-app.cobie.online
# Change this one line to serve the Kite dashboard on another hostname.
KITE_HOST=kite.cobie.online

# ---------- API process ----------
WORKER=modal
DB_BACKEND=postgres
HOST=0.0.0.0
PORT=8000
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
FONTS_DIR=
AUTH_ENABLED=1
BILLING_ENABLED=1
WEB_URL=https://pakdee-app.cobie.online
CORS_ORIGINS=https://pakdee-app.cobie.online

# ---------- Web (Next.js) runtime. DIRECT_UPLOAD=0 proxies uploads via the web pod. ----------
BACKEND_URL=http://api:8000
PUBLIC_BACKEND_URL=https://pakdee-api.cobie.online
DIRECT_UPLOAD=0

# ---------- Optional, non-secret. Leave blank if unused. ----------
# ADMIN_EMAILS, PAYMENT_PROVIDER, R2_ENABLED, R2_BUCKET, R2_ACCOUNT_ID, and
# R2_ENDPOINT are not in this ConfigMap. They belong in pakdee-secrets so an
# empty value here cannot override production, and so admin addresses are not
# committed. See deploy/k8s/secret.example.yaml.
PAYEE_NAME=
PAYEE_BANK=
PAYEE_ACCOUNT=
PDPA_CONTROLLER_NAME=
PDPA_CONTROLLER_CONTACT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=
R2_PURGE_LOCAL=0
