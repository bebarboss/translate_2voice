# Documented production edge after the 2026-11-11 cutover.
# Caddy (the existing Compose container) owns 80/443 and TLS.
# It dials the pinned k3s ClusterIP Services, not Compose api/web.
#
# The live file on the VPS is ~/translate_2voice/deploy/Caddyfile.web, edited
# in place. That checkout is a2d0f5d9859a5c14673e193dc9d2266fa23e560a, which
# has no request body limit. Do not copy this file over the live path.
# Do not git pull, git reset, or git checkout -- deploy/Caddyfile.web on the
# VPS. Compare the active file with this one and keep the active file.
# Later commits add a 600MB request_body to git's deploy/Caddyfile.web and
# still proxy to the Compose names api:8000 and web:3000. That is not live.
#
# This sample has no request_body block. Copying it onto the server does not
# add the 600MB limit from git main. It is not a byte-for-byte copy of the
# live file: compare first. It does set the reported upstreams
# 10.43.204.249:8000 and 10.43.26.212:3000, gzip, 30 minute API timeouts,
# HSTS, nosniff, and referrer-policy. The API still enforces MAX_UPLOAD_MB.

{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy 10.43.204.249:8000 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy 10.43.26.212:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
