# คัดลอกเป็น deploy/.env แล้วใส่ค่าจริง
# cp deploy/.env.vps.example deploy/.env

API_DOMAIN=pakdee-api.cobie.online
ACME_EMAIL=you@example.com

# ---------- Frontend บน VPS (bash deploy/up.sh --web) ----------
WEB_DOMAIN=pakdee-app.cobie.online
CADDYFILE=./Caddyfile.web
PUBLIC_BACKEND_URL=https://pakdee-api.cobie.online
# WEB_API_KEY=
# VPS แนะนำ 0 (อัปผ่าน /api โดเมนเดียวกัน) — Vercel ใช้ 1
DIRECT_UPLOAD=0
CORS_ORIGINS=https://pakdee-app.cobie.online

WORKER=modal

# R2 ตั้งใน ../.env

# ---------- Postgres บน VPS (ใน Docker — ไม่เปิดพอร์ตสาธารณะ) ----------
POSTGRES_USER=pakdee
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=pakdee
DB_BACKEND=postgres
DATABASE_URL=postgresql://pakdee:change-me-long-random@db:5432/pakdee?sslmode=disable
