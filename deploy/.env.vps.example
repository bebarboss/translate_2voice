# คัดลอกเป็น deploy/.env แล้วใส่ค่าจริง
# cp deploy/.env.vps.example deploy/.env

# โดเมนที่ชี้ A/AAAA มาที่ IP ของ VPS (บังคับสำหรับ API)
API_DOMAIN=api.example.com

# อีเมลสำหรับ Let's Encrypt (แนะนำ)
ACME_EMAIL=you@example.com

# ---------- Frontend บน VPS (bash deploy/up.sh --web) ----------
WEB_DOMAIN=www.example.com
CADDYFILE=./Caddyfile.web
# URL สาธารณะของ API ที่เบราว์เซอร์เรียก (ต้องตรง API_DOMAIN + https)
PUBLIC_BACKEND_URL=https://api.example.com
# คีย์เดียวกับ API_KEY ใน ../.env — ว่างได้ แล้ว up.sh --web จะคัดมาให้
# WEB_API_KEY=
# 1 = เบราว์เซอร์อัปโหลดตรงไปที่ API (แนะนำ)
DIRECT_UPLOAD=1

# CORS ของ API — ใส่โดเมนหน้าเว็บบน VPS
CORS_ORIGINS=https://www.example.com

# modal = ไม่ต้องมี GPU บน VPS (แนะนำ) | local = ต้องมี NVIDIA + docker-compose.gpu
WORKER=modal

# โฟลเดอร์สำรองบนโฮสต์ (ว่าง = ../backups)
# BACKUP_PATH=/var/backups/pakdee

# R2 ตั้งใน ../.env (ไม่ใช่ไฟล์นี้) — ดู docs/deploy-vps.md
# R2_ENABLED=1  R2_ACCOUNT_ID=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=  R2_BUCKET=pakdee-jobs

# ---------- Postgres บน VPS (ใน Docker — ไม่เปิดพอร์ตสาธารณะ) ----------
POSTGRES_USER=pakdee
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=pakdee
DB_BACKEND=supabase
# API ใช้ URL นี้ (โฮสต์ db = ชื่อ service ใน compose)
SUPABASE_DB_URL=postgresql://pakdee:change-me-long-random@db:5432/pakdee?sslmode=disable
